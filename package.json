{
  "name": "unfranchaise-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "stdio MCP + CLI for hk.unfranchise.com (17 tools): catalog/cart dry-run, Form 1000 optimiser, checkout map, placement URLs. Cookie auth.",
  "bin": {
    "unfranchaise": "cli.js",
    "kb": "kb/cli.js"
  },
  "scripts": {
    "mcp": "node server.js",
    "mcp:kb": "node kb-server.js",
    "test": "node pure-smoke.mjs && node test-form1000-optimise.mjs && node test-bugfix-safety-money.mjs && node test-bugfix-robustness.mjs && node test-kb-classify.mjs && node test-kb-search-query.mjs && node test-kb.mjs && node test-kb-mcp.mjs && node test-kb-merge.mjs && node test-kb-tool-definitions.mjs",
    "test:kb": "node test-kb-classify.mjs && node test-kb.mjs && node test-kb-mcp.mjs && node test-kb-tool-definitions.mjs",
    "kb:ship-smoke": "node scripts/kb-p2-ship-smoke.mjs",
    "kb:ingest-obsidian": "node kb/cli.js ingest-obsidian",
    "kb:ingest-manuals": "node scripts/kb-ingest-manuals.mjs",
    "kb:p1-prep": "node scripts/kb-p1-prep.mjs",
    "kb:score-eval": "node scripts/kb-score-eval.mjs",
    "kb:p1-all": "bash scripts/kb-run-p1-all.sh",
    "kb:empty-corpus-check": "node scripts/kb-empty-corpus-preflight.mjs",
    "kb:p1-host-fill": "node scripts/kb-p1-host-fill.mjs",
    "kb:p1-mcp-score": "node scripts/kb-p1-mcp-score.mjs",
    "kb:p1-rescore-retrieval": "node scripts/kb-p1-rescore-retrieval.mjs",
    "kb:p1-gate-bundle": "node scripts/kb-p1-gate-bundle.mjs",
    "kb:p2-gate": "bash .review-gate/run-product-kb-p2-full.sh",
    "kb:p2-typesafe-rate": "node scripts/kb-p2-typesafe-findings-rate.mjs",
    "kb:p2-host-wire": "node scripts/kb-p2-host-wire-evidence.mjs",
    "kb:p2-mcp-transport": "node scripts/kb-p2-mcp-transport.mjs",
    "kb:p1-fix-cites": "node scripts/kb-p1-fix-cites.mjs",
    "kb:p1-trap-evidence": "node scripts/kb-p1-trap-evidence.mjs",
    "kb:p1-delegate": "bash .review-gate/run-p1-delegation.sh",
    "kb:bootstrap-consolidation": "node scripts/kb-bootstrap-consolidation.mjs",
    "form1000:optimise": "node cli.js form1000-optimise",
    "capture": "node scripts/capture-session.mjs",
    "capture:xhr": "node scripts/capture-xhr-playwright.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cheerio": "^1.0.0"
  }
}
