{
  "name": "unfranchaise-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP + CLI for Market Hong Kong Unfranchise (hk.unfranchise.com): catalog, cart, volume rules, Form 1000 status. Dry-run by default.",
  "bin": {
    "unfranchaise": "cli.js"
  },
  "scripts": {
    "mcp": "node server.js",
    "test": "node pure-smoke.mjs && node test-form1000-optimise.mjs",
    "form1000:optimise": "node cli.js form1000-optimise",
    "capture": "node scripts/capture-session.mjs",
    "capture:xhr": "node scripts/capture-xhr-playwright.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cheerio": "^1.0.0"
  }
}
